{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/packages",
      "destination": "/packages.html"
    },
    {
      "source": "/homestays",
      "destination": "/homestays.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/gallery",
      "destination": "/our_gallery.html"
    },
    {
      "source": "/:path*/",
      "destination": "/:path*/index.html"
    }
  ],
  "env": {
    "VITE_APP_TITLE": "Real Trip - Curated Travel Experiences"
  }
}
